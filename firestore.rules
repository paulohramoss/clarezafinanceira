rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsWrittenData(userId) {
      return !('user_id' in request.resource.data) || request.resource.data.user_id == userId;
    }

    match /users/{userId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId);

      match /{document=**} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId) && ownsWrittenData(userId);
      }
    }
  }
}
